<Window x:Class="SettingsUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Usage — Settings">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent"
              AutomationProperties.Name="Window drag area" AutomationProperties.AutomationId="SettingsTitleBarDragRegion" />
        <NavigationView x:Name="Navigation" Grid.Row="0" Grid.RowSpan="2" PaneDisplayMode="Left" CompactPaneLength="48" IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False" OpenPaneLength="244" SelectionChanged="OnNavigationChanged"
        Background="Transparent" IsPaneToggleButtonVisible="True">
        <NavigationView.Resources>
            <Style x:Key="UninstallButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <StackPanel Margin="18,18,12,24" Spacing="5">
                <TextBlock Text="CODEX USAGE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="General" Icon="Setting" AutomationProperties.AutomationId="NavigationGeneral" />
            <NavigationViewItem Content="Monitoring" Tag="Monitoring" Icon="View" AutomationProperties.AutomationId="NavigationMonitoring" />
            <NavigationViewItem Content="Appearance" Tag="Appearance" Icon="Edit" AutomationProperties.AutomationId="NavigationAppearance" />
            <NavigationViewItem Content="Placement" Tag="Placement" Icon="MapPin" AutomationProperties.AutomationId="NavigationPlacement" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="NavigationUpdate" Content="Update" Tag="Update" Icon="Download" AutomationProperties.AutomationId="NavigationUpdate" />
            <NavigationViewItem Content="About" Tag="About" Icon="Help" AutomationProperties.AutomationId="NavigationAbout" />
        </NavigationView.FooterMenuItems>
        <Grid x:Name="PageContent">
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Padding="40,30,40,40" Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="PageEyebrow" Text="PREFERENCES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="PageTitle" Text="General" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSummary" Text="A few thoughtful choices make the widget feel like yours." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="PageHost" Spacing="18" />
                    <TextBlock Text="Changes are saved automatically." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <InfoBar x:Name="MessageBar" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="560" Margin="24,0,24,18" IsOpen="False" IsClosable="True" Severity="Informational" AutomationProperties.Name="Settings feedback" AutomationProperties.AutomationId="SettingsFeedback" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        </NavigationView>
    </Grid>
</Window>
